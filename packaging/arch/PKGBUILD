# Maintainer: rukiOS contributors
pkgname=ruki
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc='Keyboard-first Linux system monitor and management console'
arch=('x86_64' 'aarch64')
url='https://github.com/Ruki111/rukiOS'
license=('MIT')
depends=('coreutils' 'iproute2' 'procps-ng' 'systemd')
makedepends=('git' 'rust')
source=("rukiOS::git+https://github.com/Ruki111/rukiOS.git#branch=main")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/rukiOS"
    printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "$srcdir/rukiOS"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked
}

build() {
    cd "$srcdir/rukiOS"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --workspace
}

check() {
    cd "$srcdir/rukiOS"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --frozen --workspace
}

package() {
    cd "$srcdir/rukiOS"
    install -Dm0755 target/release/ruki "$pkgdir/usr/bin/ruki"
    install -Dm0755 target/release/ruki-monitor "$pkgdir/usr/bin/ruki-monitor"
    install -Dm0644 README.md "$pkgdir/usr/share/doc/ruki/README.md"
    install -Dm0644 COMMANDS.md "$pkgdir/usr/share/doc/ruki/COMMANDS.md"
    install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/ruki/LICENSE"
}
